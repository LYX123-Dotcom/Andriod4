<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_felt"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_game_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingTop="@dimen/game_title_padding_top"
        android:paddingRight="20dp"
        android:textColor="@color/text_on_felt_sub"
        android:textSize="@dimen/game_title_text_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingTop="@dimen/score_padding_vertical"
        android:paddingRight="20dp"
        android:paddingBottom="@dimen/score_padding_vertical">

        <TextView
            android:id="@+id/tv_score"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/score_initial"
            android:textColor="@color/text_on_felt"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_high_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/high_score_initial"
            android:textColor="@color/text_on_felt_sub"
            android:textSize="14sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="4dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_reset"
        android:layout_width="match_parent"
        android:layout_height="@dimen/action_button_height"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="@dimen/action_padding_top"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="@dimen/action_padding_bottom"
        android:gravity="center"
        android:text="@string/btn_reset_game"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:backgroundTint="@color/color_accent" />

</LinearLayout>
